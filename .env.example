# Quannex Recovery — environment configuration
#
# The pilot collections OS has a narrow config surface. Copy this file to
# `.env` for local development; set real values in production.

# Application
ENVIRONMENT=development
DEBUG=true

# Database
# Default: SQLite file in the repo root. For Postgres use:
#   DATABASE_URL=postgresql+psycopg2://user:password@host:5432/quan
DATABASE_URL=sqlite:///./quan.db

# Comma-separated CORS origins for non-development deployments.
# Ignored when ENVIRONMENT is development/dev/local.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Compliance policy knobs consumed by the compliance engine / dashboards.
MAX_WEEKLY_CONTACT_ATTEMPTS=7
CONTACT_HOURS_START=8
CONTACT_HOURS_END=21

# Security — SECRET_KEY is required in non-dev environments.
SECRET_KEY=replace-me-in-production

# Optional payment processor (install with `pip install .[payments]`).
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
