# QUAN Recovery Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=sqlite:///./quan.db
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Twilio (SMS/Voice)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid (Email)
SENDGRID_API_KEY=your_sendgrid_key
SENDGRID_FROM_EMAIL=collections@quanrecovery.com

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Google Cloud
GCP_PROJECT_ID=quan-recovery
GCS_BUCKET=quan-data
BIGQUERY_DATASET=quan_analytics

# ML Models
MODEL_REGISTRY_PATH=/models
INTELLIGENCE_ENGINE_URL=localhost:50051

# Security
SECRET_KEY=your-secret-key-change-in-production

# Monitoring
PROMETHEUS_PORT=9090
JAEGER_ENDPOINT=http://localhost:14268/api/traces
